# Only for building the firmware yourself (esphome-builder.dhcp.yaml): the
# prebuilt firmware needs none of these. Copy the keys your stub uses into your
# ESPHome secrets.yaml (Builder -> Secrets, i.e. /config/esphome/secrets.yaml).
# It is gitignored -- never commit real values. Each is optional, as its block
# in the stub is.

# --- Wi-Fi ---
wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# --- Password for uploads from ESPHome Builder ---
# Set this to the SAME password your current firmware uses, so wireless updates
# keep working without a USB re-flash.
ota_password: "choose-an-ota-password"

# --- Home Assistant native API encryption key (device appears in HA) ---
# Generate a fresh 32-byte base64 key, e.g. `openssl rand -base64 32`, or let the
# ESPHome dashboard generate one. Paste the SAME key into Home Assistant when it
# asks you to add the discovered device.
api_key: "PASTE_A_32_BYTE_BASE64_KEY_HERE="

# --- The add-on's address ---
# wss://, Home Assistant's address on your network, and the add-on's port.
va_url: "wss://192.0.2.10:8080/"

# --- The add-on's device secret ---
# The SAME value as the add-on's `device_secret` option: at least 16 characters,
# no spaces, e.g. from `openssl rand -hex 32`. The device sends it to connect.
va_secret: "the-add-ons-device-secret"

# --- The add-on's certificate ---
# The device only connects to an add-on with exactly this certificate. The
# add-on prints it in its log at every start (and keeps it in
# certificate.pem in its tls folder); paste it whole, as a block like this:
va_certificate: |
  -----BEGIN CERTIFICATE-----
  PASTE THE LINES FROM THE ADD-ON'S LOG HERE
  -----END CERTIFICATE-----

# --- Static IP (ONLY if you enable the static-IP block in your device stub) ---
# DHCP is the default; the firmware ignores these unless your stub adds the
# manual_ip override (see esphome-builder.static-ip.yaml). Use your own LAN values.
static_ip: "192.168.1.50"
gateway: "192.168.1.1"
subnet: "255.255.255.0"
dns1: "1.1.1.1"
dns2: "1.0.0.1"
