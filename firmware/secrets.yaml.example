# Only for building the firmware yourself (esphome-builder.dhcp.yaml, or
# esphome-builder.static-ip.yaml for a fixed IP): the prebuilt firmware needs
# none of these. Copy the keys your stub uses into your ESPHome secrets.yaml
# (Builder -> Secrets, i.e. /config/esphome/secrets.yaml). It is gitignored --
# never commit real values. Each but ota_password is optional, as its block in
# the stub is.

# --- Wi-Fi ---
wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# --- Password for uploads from ESPHome Builder ---
# The prebuilt firmware takes no network uploads, so the first install of a
# self-built firmware onto a device running it is over USB. After that, Builder
# uploads with this password.
ota_password: "choose-an-ota-password"

# --- Home Assistant native API encryption key (device appears in HA) ---
# Generate a fresh 32-byte base64 key, e.g. `openssl rand -base64 32`, or let the
# ESPHome dashboard generate one. Paste the SAME key into Home Assistant when it
# asks you to add the discovered device.
api_key: "PASTE_A_32_BYTE_BASE64_KEY_HERE="

# --- The add-on's address ---
# wss://, Home Assistant's address on your network, and the add-on's port.
va_url: "wss://192.0.2.10:8080/"

# --- The add-on's device secret ---
# The SAME value as the add-on's `device_secret` option: 16 to 128 visible ASCII
# characters, no spaces, e.g. from `openssl rand -hex 32`. The device sends it to connect.
va_secret: "the-add-ons-device-secret"

# --- The add-on's certificate ---
# The device only connects to an add-on with exactly this certificate. The
# add-on prints it in its log at every start (and keeps it in
# certificate.pem in its tls folder); paste it whole, as a block like this:
va_certificate: |
  -----BEGIN CERTIFICATE-----
  PASTE THE LINES FROM THE ADD-ON'S LOG HERE
  -----END CERTIFICATE-----

# --- Static IP (ONLY with esphome-builder.static-ip.yaml) ---
# That stub is the one for a fixed IP; esphome-builder.dhcp.yaml uses none of
# these. Use your own LAN values.
static_ip: "192.0.2.50"
gateway: "192.0.2.1"
subnet: "255.255.255.0"
dns1: "1.1.1.1"
dns2: "1.0.0.1"
